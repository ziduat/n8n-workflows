      "name": "PropertyFeatures"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n\n  // Helper function for cleaning data\n  const cleanNumber = (text) => {\n    if (!text) return '';\n    // Removing kammas\n    return text.toString().replace(/[^0-9,.]/g, '').replace(/,/g, '');\n  };\n  \n  // Get property features\n  const titles = item.json.all_features_titles || [];\n  const values = item.json.all_features_values || [];\n\n  // Get financial table data\n  //const financeTitles = item.json.financial_titles || [];\n  const financeValues = item.json.financial_values || [];\n  \n  let featureData = {};\n  // Loop through titles and map each value to its title\n  for (let i = 0; i < titles.length; i++) {\n      // Clean the title: lower case, replace spaces with underscores, remove special chars\n    let key = titles[i]\n      .trim()\n      .toLowerCase()\n      .replace(/[^a-z0-9]/g, '_')\n      .replace(/_+/g, '_');\n      \n    // Assign the corresponding value to the cleaned key\n    featureData[key] = values[i] || '';\n  }\n\n  // Extract property_id from the url if it exists\n  let propertyId = '';\n  if (item.json.url) {\n    propertyId = item.json.url.split('/').pop();\n  }\n\n  const brokerLinks = item.json.broker_links || [];\n  const fullBrokerUrls = brokerLinks.map(link => `https://www.centris.ca${link}`);\n  \n  const brokerIds = brokerLinks.map(link => link.split('/').pop());\n  \n  // Return the original fields plus the newly created feature columns\n  return {\n    json: {\n      Property_link: item.json.url || '',\n      Property_ID: propertyId,\n      BrokersLink: fullBrokerUrls.join(', '),\n      BrokersID: brokerIds.join(', '),\n      Type: item.json.Type || '',\n      Price: item.json.Price || '',\n      Address: item.json.Address || '',\n      Rooms: cleanNumber(item.json.Rooms),\n      Bedrooms: cleanNumber(item.json.Bedrooms),\n      Bathrooms: cleanNumber(item.json.Bathrooms),\n      ...featureData ,\n      assessLot: financeValues[0] || '',\n      assessBuilding: financeValues[1] || '',\n      assessTotal: financeValues[2] || '',\n      taxMunicipal: financeValues[6] || '',\n      taxSchool: financeValues[7] || '',\n      taxTotal: financeValues[8] || '',\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
